# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Two valid options (both keep session state, which migrations need):
# 1. Session pooler (IPv4, works everywhere incl. WSL2 without IPv6):
#    postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 2. Direct connection (IPv6 only — needs IPv6 connectivity or the IPv4 add-on):
#    postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Do NOT use the transaction pooler (pooler.supabase.com:6543) — config fails fast on it.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Google (embeddings via Gemini; LLM later via pydantic-ai) ---

GOOGLE_API_KEY=your-GOOGLE_API_KEY-api-key
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# --- Cohere (optional: reranker for Phase 5+ retrieval; reranking is skipped if unset) ---

COHERE_API_KEY=your-COHERE_API_KEY-api-key

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173